CHIP CPU {
    IN inM[16], instruction[16], reset;
    OUT outM[16], writeM, addressM[15], pc[15];

    PARTS:
    // Decode instruction type.
    Not(in=instruction[15], out=isA);
    And(a=instruction[15], b=instruction[5], out=loadAFromC);
    Or(a=isA, b=loadAFromC, out=loadA);

    // A receives the instruction value for an A-instruction,
    // or the ALU result when a C-instruction has dest=A.
    Mux16(a=instruction, b=aluOut, sel=instruction[15], out=aInput);
    ARegister(in=aInput, load=loadA, out=aReg, out[0..14]=addressM);

    // D is loaded only for a C-instruction with dest=D.
    And(a=instruction[15], b=instruction[4], out=loadD);
    DRegister(in=aluOut, load=loadD, out=dReg);

    // Select A or M as the ALU y input using the a-bit.
    Mux16(a=aReg, b=inM, sel=instruction[12], out=aluY);
    ALU(
        x=dReg, y=aluY,
        zx=instruction[11], nx=instruction[10],
        zy=instruction[9],  ny=instruction[8],
        f=instruction[7],   no=instruction[6],
        out=aluOut, zr=zr, ng=ng
    );

    // Memory write is enabled by dest=M on a C-instruction.
    And(a=instruction[15], b=instruction[3], out=writeM);
    Or16(a=aluOut, b=false, out=outM);

    // Evaluate the three signed jump conditions.
    Not(in=zr, out=notZr);
    Not(in=ng, out=notNg);
    And(a=notNg, b=notZr, out=isPositive);
    And(a=instruction[0], b=isPositive, out=jumpGT);
    And(a=instruction[1], b=zr, out=jumpEQ);
    And(a=instruction[2], b=ng, out=jumpLT);
    Or(a=jumpGT, b=jumpEQ, out=jumpGTorEQ);
    Or(a=jumpGTorEQ, b=jumpLT, out=jumpRequested);
    And(a=instruction[15], b=jumpRequested, out=loadPC);

    PC(in=aReg, load=loadPC, inc=true, reset=reset, out=pc);
}