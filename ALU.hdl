CHIP ALU {
 IN x[16], y[16], zx, nx, zy, ny, f, no;
 OUT out[16], zr, ng;
 PARTS:
    Mux16(a=x, b=false, sel=zx, out=x0);
    Not16(in=x0, out=notx0);
    Mux16(a=x0, b=notx0, sel=nx, out=x1);
    Mux16(a=y, b=false, sel=zy, out=y0);
    Not16(in=y0, out=noty0);
    Mux16(a=y0, b=noty0, sel=ny, out=y1);
    And16(a=x1, b=y1, out=andxy);
    Add16(a=x1, b=y1, out=addxy);
    Mux16(a=andxy, b=addxy, sel=f, out=pre);
    Not16(in=pre, out=notpre);
    Mux16(a=pre, b=notpre, sel=no, out=out);
    Or8Way(in=out[0..7], out=zrlo);
    Or8Way(in=out[8..15], out=zrhi);
    Or(a=zrlo, b=zrhi, out=any);
    Not(in=any, out=zr);
    And(a=out[15], b=true, out=ng);
}
